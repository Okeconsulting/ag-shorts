# ==============================================================================
# CONFIGURACIÓN DE APIS Y MODELOS - MOTOR DE TEXT-TO-VIDEO AG-SHORTS
# ==============================================================================

# 1. Credenciales de Google AI Studio (Gemini & Imagen)
# Obtén tu API Key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_google_aqui

# 2. Configuración de Modelos de Lenguaje (Agente Director)
# Opciones recomendadas: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# 3. Configuración de Generación Visual (Google Imagen 3)
# Modelo de generación de imágenes: imagen-3.0-generate-002
IMAGEN_MODEL=imagen-3.0-generate-002

# 4. Configuración de Voz (Edge-TTS Local)
# Opciones recomendadas: es-CL-LorenzoNeural, es-MX-JorgeNeural, es-ES-AlvaroNeural
TTS_VOICE=es-CL-LorenzoNeural

# 5. Configuración de Video y Renderizado
VIDEO_FPS=30
VIDEO_OUTPUT=short_final.mp4
